{
  "name": "nucleus-sjec",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nucleus SJEC — student innovation community website (React + Vite SSR frontend, Express + SQLite backend).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.mjs\" \"next dev --hostname 127.0.0.1\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:legacy": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --watch server/index.mjs",
    "build": "npm run typecheck && npm run build:legacy && next build",
    "build:legacy": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "typecheck": "tsc -b",
    "start": "node server/start.mjs",
    "admin:create": "node server/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npx playwright test",
    "check": "npm run build && npm test",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
