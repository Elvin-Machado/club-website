{
  "name": "nucleus-sjec",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nucleus SJEC — student innovation community website (React + Vite SSR frontend, Express + SQLite backend).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "npm run typecheck && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "typecheck": "tsc -b",
    "start": "node server/index.mjs",
    "admin:create": "node server/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "gsap": "^3.15.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.6",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
