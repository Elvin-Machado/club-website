{
  "name": "nucleus-sjec",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nucleus SJEC — student innovation community website (Next.js App Router frontend, Express + SQLite backend).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.mjs\" \"next dev --hostname 127.0.0.1 --port 3000\"",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:api": "node --watch server/index.mjs",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run typecheck && next build && npm run build:vite",
    "build:vite": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "typecheck": "tsc -b",
    "start": "node server/start.mjs",
    "admin:create": "node server/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','.next','tsconfig.tsbuildinfo','test-results','playwright-report'])fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
